# ==============================================================================
# ARCHITECTURE FACULTY SHIRT PRE-ORDER SYSTEM - .gitignore
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production Build Outputs
dist/
dist-ssr/
build/
out/
*.local

# Environment Variables & Secrets (Keep confidential keys safe)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# (Keep .env.example tracked in git)
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & IDE Configs
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Deployment & Temporary Caches
.tempmediaStorage/
.cache/
.parcel-cache/
.turbo/
.vercel/
.netlify/
